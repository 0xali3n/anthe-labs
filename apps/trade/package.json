{
  "name": "trade",
  "version": "1.0.0",
  "description": "Trade execution service for copy trading",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "test:trade": "ts-node-dev --transpile-only src/test-trade.ts"
  },
  "dependencies": {
    "@aptos-labs/ts-sdk": "^5.1.1",
    "@prisma/client": "^7.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "axios": "^1.7.9",
    "dotenv": "^17.2.3",
    "ioredis": "^5.8.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/ioredis": "^5.0.0",
    "prisma": "^7.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}

